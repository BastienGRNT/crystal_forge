# Clé maître (32 octets) qui chiffre les jetons et les .env en base.
# Générez-la UNE fois et sauvegardez-la : sans elle, les secrets stockés sont illisibles.
#   openssl rand -base64 32
FORGE_MASTER_KEY=

# true par défaut : toutes les écritures sont journalisées mais pas exécutées.
# Passez à false seulement quand « Tester les connexions » est entièrement vert.
DRY_RUN=true

# live (vraies API) ou mock (infrastructure simulée, pour découvrir l'interface).
FORGE_MODE=live

# Adresses autorisées à joindre l'interface (via Tailscale, les requêtes arrivent
# depuis 10.10.10.1 à cause du SNAT du routeur de sous-réseau).
FORGE_ALLOWED_SOURCES=127.0.0.1/32,::1/128,10.10.10.1/32,100.64.0.0/10

# Mettre true si Forge est servi en HTTPS (cookie de session « Secure »).
FORGE_SECURE_COOKIES=false

# Mot de passe admin perdu : mettre à 1, redémarrer, lire dans les logs le lien /reset/<jeton> (valable 30 min), puis remettre à 0.
FORGE_ADMIN_RESET=0
